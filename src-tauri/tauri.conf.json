{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAM Cleaner",
  "version": "0.1.0",
  "identifier": "com.muham.ram-cleaner",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RAM Cleaner",
        "width": 1100,
        "height": 820,
        "minWidth": 820,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Raldex",
    "copyright": "Copyright 2026 Raldex",
    "category": "Utility",
    "shortDescription": "Frees RAM by trimming the memory background apps hold on to",
    "longDescription": "RAM Cleaner shows live memory usage, trims the working sets of background apps on demand or automatically, and keeps protected apps untouched.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "RAM Cleaner",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
